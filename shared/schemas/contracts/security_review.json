{
  "$defs": {
    "Principal": {
      "additionalProperties": false,
      "description": "Who approved. ``identity_provider`` records how much the identity can be trusted.",
      "properties": {
        "audit_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reserved for signed audit metadata in production.",
          "title": "Audit Signature"
        },
        "auth_method": {
          "description": "header | oidc_bearer | chat_message | \u2026",
          "title": "Auth Method",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "identity_provider": {
          "enum": [
            "dev_header",
            "oidc",
            "natural_language",
            "system"
          ],
          "title": "Identity Provider",
          "type": "string"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "subject_id": {
          "description": "Stable subject identifier from the identity provider.",
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "tenant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        }
      },
      "required": [
        "subject_id",
        "identity_provider",
        "auth_method"
      ],
      "title": "Principal",
      "type": "object"
    }
  },
  "$id": "https://noricum.bio/schemas/contracts/security_review.json",
  "additionalProperties": false,
  "description": "Bound to the assessment hash so a review cannot be replayed against a changed assessment.",
  "properties": {
    "assessment_hash": {
      "minLength": 1,
      "title": "Assessment Hash",
      "type": "string"
    },
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "denied"
      ],
      "title": "Decision",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "plan_hash": {
      "minLength": 1,
      "title": "Plan Hash",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "resulting_outcome": {
      "description": "ALLOW_WITH_APPROVAL when approved (human approval still required), DENY when denied.",
      "enum": [
        "ALLOW",
        "ALLOW_WITH_APPROVAL",
        "REQUIRE_REVIEW",
        "DENY"
      ],
      "title": "Resulting Outcome",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "trace_id": {
      "description": "Shared by every record of one scientific loop (orch_<uuid7>).",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "review_id",
    "assessment_id",
    "assessment_hash",
    "plan_id",
    "plan_hash",
    "decision",
    "resulting_outcome",
    "principal"
  ],
  "title": "SecurityReview",
  "type": "object"
}
