{
  "$defs": {
    "ExecutionInput": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. reads_r1, samplesheet, reference",
          "title": "Role"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ExecutionInput",
      "type": "object"
    }
  },
  "$id": "https://noricum.bio/schemas/contracts/execution_request.json",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Required for anything that is not read-only.",
      "title": "Approval Id"
    },
    "capability_id": {
      "title": "Capability Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_intent_hash": {
      "minLength": 1,
      "title": "Execution Intent Hash",
      "type": "string"
    },
    "execution_intent_id": {
      "title": "Execution Intent Id",
      "type": "string"
    },
    "execution_request_id": {
      "title": "Execution Request Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 16,
      "title": "Idempotency Key",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ExecutionInput"
      },
      "title": "Inputs",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
    },
    "provider_handle": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider-side identifier once submitted.",
      "title": "Provider Handle"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "submitted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submitted At"
    },
    "trace_id": {
      "description": "Shared by every record of one scientific loop (orch_<uuid7>).",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "trace_id",
    "execution_request_id",
    "execution_intent_id",
    "execution_intent_hash",
    "idempotency_key",
    "provider_id",
    "capability_id"
  ],
  "title": "ExecutionRequest",
  "type": "object"
}
