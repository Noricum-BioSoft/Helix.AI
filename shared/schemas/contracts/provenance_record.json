    "outputs": {
      "description": "Ids/URIs produced.",
      "items": {
        "type": "string"
      },
      "title": "Outputs",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": true,
      "title": "Parameters",
      "type": "object"
